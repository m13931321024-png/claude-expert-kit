{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Canonical Skill Format v0.2",
  "description": "claude-expert-kit canonical skill (frontmatter portion of *.md)",
  "type": "object",
  "required": ["name", "type", "description"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z_]+:[\\w\\-一-龥]+$",
      "description": "Unique identifier in 'namespace:slug' form"
    },
    "type": {
      "type": "string",
      "enum": ["expert", "internal", "tool"],
      "description": "expert = top-level routed; internal = called by experts; tool = pure utility"
    },
    "description": {
      "type": "string",
      "maxLength": 200,
      "description": "One-liner shown to the agent (CC injects this into system prompt)"
    },
    "priority": {
      "type": "string",
      "enum": ["high", "medium", "low"],
      "default": "medium"
    },
    "chain": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z_]+:[\\w\\-一-龥]+$" },
      "description": "Successor experts (only meaningful for type:expert)"
    },
    "calls": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z_]+:[\\w\\-一-龥]+$" },
      "description": "On-demand SlashCommand invocations from this skill body"
    },
    "keywords": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Single source of truth for routing: hook does literal matching against this list; V3 embedding will use the same field. Replaced the old 'triggers' field (v0.2.1)."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[\\w\\.\\-]+)?$",
      "default": "0.1.0"
    },
    "platforms": {
      "type": "array",
      "items": { "type": "string", "enum": ["claude-code", "codex", "cursor"] },
      "default": ["claude-code"]
    },
    "maintainer": { "type": "string" }
  }
}
